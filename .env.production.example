# Reference only: add these variables in each Render service's Environment settings.
# Replace every placeholder with the service's actual URL/credentials.
# Do not upload this file as a service's environment file or commit real secrets.

# NestJS API web service
NODE_ENV=production
# Render supplies PORT automatically.
WEB_URL=https://YOUR-WEB-SERVICE.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST:5432/DATABASE?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=https://YOUR-WEB-SERVICE.onrender.com,https://YOUR-ADMIN-SERVICE.onrender.com
# Optional; only set this if the API uses Redis.
# REDIS_URL=rediss://USER:PASSWORD@YOUR-REDIS-HOST:PORT

# Each Next.js web service (web and platform-admin) needs its own actual app URL.
# Set both at build and runtime. API_INTERNAL_URL is server-only; public URL is used by the browser.
NEXT_PUBLIC_APP_URL=https://YOUR-WEB-SERVICE.onrender.com
NEXT_PUBLIC_API_URL=https://YOUR-API-SERVICE.onrender.com/api/v1
API_INTERNAL_URL=https://YOUR-API-SERVICE.onrender.com/api/v1

# Django AI service (separate Render web service, if deployed).
NODE_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=GENERATE_A_DIFFERENT_RANDOM_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=YOUR-AI-SERVICE.onrender.com
DJANGO_CORS_ALLOWED_ORIGINS=
AI_SERVICE_SHARED_SECRET=GENERATE_A_DIFFERENT_RANDOM_SERVICE_SECRET
AI_SERVICE_TOKEN_TTL_SECONDS=180
