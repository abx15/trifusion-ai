{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "noEmitOnError": false,
    "rootDir": "./src",
    "paths": {
      "@/*": ["src/*"],
      "@trifusion/contracts": ["../../packages/contracts/src"],
      "@trifusion/config": ["../../packages/config/src"],
      "@trifusion/utils": ["../../packages/utils/src"],
      "@trifusion/database": ["../../database/prisma/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
