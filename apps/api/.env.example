# TriFusion AI - API Environment Variables
# Copy this to .env for local development

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trifusion_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
AUTH_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS_PER_REQUEST=4000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_TOKENS_PER_USER_PER_DAY=100000

# ============================================
# OBJECT STORAGE CONFIGURATION
# ============================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trifusion-dev-uploads
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/csv

# ============================================
# PAYMENT PROVIDER CONFIGURATION
# ============================================
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@trifusion.dev
SENDGRID_FROM_NAME=TriFusion AI (Dev)

# ============================================
# MONITORING AND LOGGING
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# ============================================
# WEBHOOK CONFIGURATION
# ============================================
WEBHOOK_TIMEOUT_MS=5000

# ============================================
# SECURITY CONFIGURATION
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_MAX_AGE_MS=604800000

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ASSISTANT=true
FEATURE_FILE_UPLOADS=true
FEATURE_NOTIFICATIONS=true
FEATURE_REALTIME=true
FEATURE_BILLING=false
FEATURE_REPORTS=true

# ============================================
# DEVELOPMENT CONFIGURATION
# ============================================
DEBUG=true
HOT_RELOAD=true
