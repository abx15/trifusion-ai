# TriFusion AI - Web App Environment Variables
# Copy this to .env for local development

# ============================================
# NEXT.JS CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-only NestJS URL for the same-origin authenticated API proxy.
API_INTERNAL_URL=http://localhost:3001/api/v1

# ============================================
# FEATURE FLAGS (CLIENT-SIDE)
# ============================================
NEXT_PUBLIC_FEATURE_AI_ASSISTANT=true
NEXT_PUBLIC_FEATURE_FILE_UPLOADS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_REALTIME=true
NEXT_PUBLIC_FEATURE_BILLING=false
NEXT_PUBLIC_FEATURE_REPORTS=true

# ============================================
# ANALYTICS
# ============================================
# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# AUTH PROVIDER (CLIENT-SIDE)
# ============================================
# If using Supabase Auth
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# If using Auth0
# NEXT_PUBLIC_AUTH0_DOMAIN=your-domain.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
# NEXT_PUBLIC_AUTH0_AUDIENCE=your-api-audience

# ============================================
# SENTRY (CLIENT-SIDE)
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
