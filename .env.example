# TriFusion AI - Environment Variables Template
# Copy this file to .env for local development
# Copy this file to .env.production for production deployment
# NEVER commit actual .env files with real secrets

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/trifusion_dev

# Database pool configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis URL for caching and queues
# Format: redis://host:port
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
# JWT Secret for token signing (generate a secure random string)
AUTH_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Configuration
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# If using external auth provider (e.g., Supabase, Auth0)
# AUTH_PROVIDER=supabase
# AUTH_ISSUER_URL=https://your-provider.auth0.com
# AUTH_AUDIENCE=your-api-audience
# AUTH_CLIENT_ID=your-client-id
# AUTH_CLIENT_SECRET=your-client-secret

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Choose your AI provider: openai, anthropic, google, or local
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration (if using Anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-opus-20240229

# AI Rate Limits
AI_MAX_TOKENS_PER_REQUEST=4000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_TOKENS_PER_USER_PER_DAY=100000

# ============================================
# OBJECT STORAGE CONFIGURATION
# ============================================
# S3-compatible storage (AWS S3, DigitalOcean Spaces, MinIO, etc.)
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trifusion-uploads
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/csv

# ============================================
# PAYMENT PROVIDER CONFIGURATION
# ============================================
# Choose payment provider: stripe, razorpay
PAYMENT_PROVIDER=stripe

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Razorpay Configuration (alternative)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email provider: sendgrid, ses, mailgun, or smtp
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@trifusion.ai
SENDGRID_FROM_NAME=TriFusion AI

# SMTP Configuration (alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_SECURE=false

# ============================================
# MONITORING AND LOGGING
# ============================================
# Error tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Logging level: error, warn, info, debug
LOG_LEVEL=debug

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# RATE LIMITING
# ============================================
# Rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=60

# Rate limit per authenticated user per minute
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# ============================================
# WEBHOOK CONFIGURATION
# ============================================
# Webhook timeout in milliseconds
WEBHOOK_TIMEOUT_MS=5000

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Session configuration
SESSION_MAX_AGE_MS=604800000

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features
FEATURE_AI_ASSISTANT=true
FEATURE_FILE_UPLOADS=true
FEATURE_NOTIFICATIONS=true
FEATURE_REALTIME=true
FEATURE_BILLING=false
FEATURE_REPORTS=true

# ============================================
# DEVELOPMENT CONFIGURATION
# ============================================
# Enable debug mode (only in development)
DEBUG=true

# Enable hot reload
HOT_RELOAD=true

# ============================================
# PRODUCTION CONFIGURATION
# ============================================
# These should be set in .env.production
# NODE_ENV=production
# DEBUG=false
# HOT_RELOAD=false
# LOG_LEVEL=info
