# TriFusion AI Environment Variables Example
# Copy this file to .env and fill in real values for local development.
# Never commit real secrets to version control.

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS_PER_REQUEST=4000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_TOKENS_PER_USER_PER_DAY=100000

# ============================================
# OBJECT STORAGE CONFIGURATION
# ============================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trifusion-dev-uploads
OBJECT_STORAGE_ACCESS_KEY=<minio-access-key>
OBJECT_STORAGE_SECRET_KEY=<minio-secret-key>
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,text/csv

# ============================================
# PAYMENT PROVIDER CONFIGURATION
# ============================================
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<sendgrid-api-key>
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=TriFusion AI

# ============================================
# MONITORING AND LOGGING
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=120

# ============================================
# WEBHOOK CONFIGURATION
# ============================================
WEBHOOK_TIMEOUT_MS=5000

# ============================================
# SECURITY CONFIGURATION
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_MAX_AGE_MS=604800000

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ASSISTANT=true
FEATURE_FILE_UPLOADS=true
FEATURE_NOTIFICATIONS=true
FEATURE_REALTIME=true
FEATURE_BILLING=false
FEATURE_REPORTS=true

# ============================================
# DEVELOPMENT CONFIGURATION
# ============================================
DEBUG=true
HOT_RELOAD=true

# ============================================
# DATABASE URLS (Neon / PostgreSQL)
# ============================================
DATABASE_URL=<postgresql://user:pass@host:5432/db?sslmode=require>
DIRECT_URL=<postgresql://user:pass@host:5432/db?sslmode=require>
DATABASE_URL_TEST=<postgresql://user:pass@host:5432/test_db?sslmode=require>
DIRECT_URL_TEST=<postgresql://user:pass@host:5432/test_db?sslmode=require>
ALLOW_DEV_SEED=false
DATABASE_URL_UNPOOLED=<postgresql://user:pass@host:5432/db?sslmode=require>
NEON_BRANCH=production

SMTP_PORT=587
SMTP_PASSWORD=<smtp-password>
SMTP_SECURE=false
SMTP_USER=<smtp-user>
EMAIL_FROM=<from-email>
SMTP_HOST=smtp.gmail.com
