# Local development template. Copy to .env and replace values as needed.
# Never commit .env files or use these example values in production.

# NestJS API
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/trifusion_dev?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=10
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/trifusion_dev?schema=public
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional API dependencies/configuration
# REDIS_URL=redis://localhost:6379
# DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/trifusion_test?schema=public
# DIRECT_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/trifusion_test?schema=public
# DATABASE_URL_SEED=postgresql://USER:PASSWORD@localhost:5432/trifusion_seed?schema=public
# ALLOW_DEV_SEED=false

# Next.js web and platform-admin services.
# Set NEXT_PUBLIC_API_URL at build time; it must end in /api/v1.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Server-to-server URL used by the Next.js API proxy. Omit to use NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:3001/api/v1

# Django AI service (only if running it locally).
DJANGO_SECRET_KEY=replace-with-a-different-random-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
AI_SERVICE_SHARED_SECRET=replace-with-a-separate-random-service-secret
AI_SERVICE_TOKEN_TTL_SECONDS=180
