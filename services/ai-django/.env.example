# TriFusion AI - Django AI Service Environment Variables
# Copy this to .env for local development

# ============================================
# DJANGO CONFIGURATION
# ============================================
DJANGO_SECRET_KEY=your-django-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# CORS CONFIGURATION
# ============================================
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
