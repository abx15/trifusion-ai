# Local Django AI service template. Never commit real secrets.
NODE_ENV=development
DJANGO_SECRET_KEY=replace-with-a-random-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
DJANGO_ADMIN_ENABLED=false

# PostgreSQL database configuration (separate from NestJS Prisma database)
DJANGO_DATABASE_NAME=trifusion_ai
DJANGO_DATABASE_USER=postgres
DJANGO_DATABASE_PASSWORD=postgres
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=5432
DJANGO_DATABASE_SSLMODE=require

# Redis configuration for quota storage (optional, falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379/0

# Internal NestJS -> Django signed service-token settings.
# Set the same value on the API service if/when it issues AI service tokens.
AI_SERVICE_SHARED_SECRET=replace-with-a-separate-random-service-secret
AI_SERVICE_TOKEN_TTL_SECONDS=180
AI_SERVICE_ISSUER=trifusion-ai
AI_SERVICE_AUDIENCE=ai-django

# AI Provider configuration
AI_PROVIDER=mock
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_MAX_TOKENS_PER_REQUEST=4000
AI_MAX_INPUT_SIZE=100000
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.2

# Quota configuration
AI_QUOTA_USER_DAILY_REQUESTS=100
AI_QUOTA_WORKSPACE_DAILY_REQUESTS=500
AI_QUOTA_USER_DAILY_TOKENS=50000
AI_QUOTA_WORKSPACE_DAILY_TOKENS=250000
