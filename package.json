{
  "name": "trifusion-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Business Workspace for individuals, freelancers, digital agencies, and IT/service companies",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "pnpm --dir database/prisma prisma generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "cd database/prisma && pnpm prisma generate",
    "db:migrate": "cd database/prisma && pnpm prisma migrate dev",
    "db:migrate:deploy": "cd database/prisma && pnpm prisma migrate deploy",
    "db:studio": "cd database/prisma && pnpm prisma studio",
    "db:seed": "pnpm --filter @trifusion/seeds seed",
    "db:reset": "cd database/prisma && pnpm prisma migrate reset",
    "codegen:contracts": "node scripts/codegen-contracts.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "database/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/graphql": "^12.2.2",
    "graphql": "16"
  }
}
